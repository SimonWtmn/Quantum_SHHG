    "## 1. Stage check (run this first!)\n",
    "\n",
    "Confirm the wave-plate actually rotates **before** a long scan. Watch for `Stage ... moved to ...`\n",
    "and the read-back angle. Close the Thorlabs Kinesis app first (it locks the USB)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "0718d019",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  commanded     0 deg  ->  reads 0.000 deg\n",
      "  commanded    20 deg  ->  reads 20.002 deg\n",
      "  commanded    40 deg  ->  reads 40.002 deg\n",
      "Stage OK — it moves.\n"
     ]
    }
   ],
   "source": [
    "if LIVE_HARDWARE:\n",
    "    from src.hardware import RotationStageController\n",
    "    _st = RotationStageController([PRM1_SERIAL]).connect()\n",
    "    assert _st.stages, (\"Stage did NOT connect. Close the Thorlabs Kinesis app, \"\n",
    "                        \"check the USB cable, and verify PRM1_SERIAL.\")\n",
    "    if HOME_STAGE:\n",
    "        _st.home(PRM1_SERIAL)\n",
    "    for _a in (0, 20, 40):\n",
    "        _st.move_to(_a, PRM1_SERIAL)\n",
    "        print(f\"  commanded {_a:5g} deg  ->  reads {_st.position(PRM1_SERIAL):.3f} deg\")\n",
    "    _st.disconnect_all()\n",
    "    print(\"Stage OK \u2014 it moves.\")\n",
    "else:\n",
    "    print(\"[offline] stage test skipped.\")"
   ]
  },
